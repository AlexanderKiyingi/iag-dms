# Production — run migrations separately; never seed or auto-migrate in-process.
ENVIRONMENT=production
PORT=4010
LOG_LEVEL=info
LOG_FORMAT=json

JWT_ISSUER=https://auth.example.com
JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUDIENCE=iag.dms
SERVICE_CLIENT_ID=iag-dms
SERVICE_CLIENT_SECRET=replace-with-secret-store-value-min-16-chars
AUTH_TOKEN_URL=https://auth.example.com/oauth/token

DATABASE_URL=postgres://svc_iag_dms:SECRET@pgbouncer:6432/iag_platform?sslmode=require
AUTO_MIGRATE=false
SEED_ON_EMPTY=false

GATEWAY_API_PREFIX=/api/v1/dms
PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
EVENT_BUS_ENABLED=true
KAFKA_BROKERS=redpanda:9092
CONSUMER_ENABLED=true
CONSUMER_TOPIC=iag.commercial
CONSUMER_GROUP_ID=iag-dms

FINANCE_URL=https://api.example.com/api/v1/finance

# ---- attachment storage ------------------------------------------------------
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO). When these four
# are set the bucket is used; otherwise DMS falls back to FILE_STORAGE_DIR, which
# is a directory INSIDE the container and therefore ephemeral on Railway without
# a mounted volume - uploads survive until the next redeploy and then vanish.
# Booting in production on the disk fallback logs a WARN saying exactly that.
S3_ENDPOINT=<bucket-host-without-scheme>      # e.g. <account>.r2.cloudflarestorage.com
S3_BUCKET=iag-documents
S3_ACCESS_KEY_ID=replace-from-secret-store
S3_SECRET_ACCESS_KEY=replace-from-secret-store
# Optional, shown with their defaults.
S3_REGION=auto                                 # "auto" suits R2; set a real region for AWS
S3_USE_SSL=true                                # only a literal "false" disables TLS
FILE_STORAGE_DIR=./data/attachments            # fallback only
